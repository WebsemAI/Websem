{
  "name": "@websem/client",
  "version": "0.1.0",
  "description": "Side-effect-free browser client for websem semantic search artifacts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check src test",
    "lint": "eslint src test",
    "test": "vitest run --watch=false"
  },
  "dependencies": {
    "@websem/types": "0.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
