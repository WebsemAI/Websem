{
  "name": "@websem/client",
  "version": "0.1.3",
  "description": "Side-effect-free browser client for websem semantic search artifacts",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebsemAI/Websem.git",
    "directory": "packages/typescript/client"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check src test",
    "lint": "eslint src test",
    "test": "vitest run --watch=false"
  },
  "dependencies": {
    "@websem/types": "0.1.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
