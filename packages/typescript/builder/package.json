{
  "name": "@websem/builder",
  "version": "0.1.4",
  "description": "Node.js artifact builder for websem browser semantic search",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebsemAI/Websem.git",
    "directory": "packages/typescript/builder"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "websem-build": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --check src test vitest.config.ts",
    "lint": "eslint src test vitest.config.ts",
    "test": "vitest run --watch=false"
  },
  "dependencies": {
    "@websem/client": "0.1.4",
    "@websem/types": "0.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.9"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
